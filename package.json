{
  "name": "dispatchgrid",
  "version": "0.1.0",
  "private": true,
  "description": "DispatchGrid - Intelligent Workforce Scheduling & Recovery Engine",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "start": "node backend/dist/server.js",
    "build": "npm run prisma:generate && npm run db:push && npm run build:backend && npm run build:frontend && npm run seed",
    "render:build": "npm run prisma:generate && npm run db:push && npm run build:backend && npm run build:frontend && npm run seed",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=backend",
    "prisma:reset": "npm run prisma:reset --workspace=backend",
    "prisma:studio": "npm run prisma:studio --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "verify:schedule": "npm run verify:schedule --workspace=backend",
    "verify:optimization": "npm run verify:optimization --workspace=backend",
    "verify:recovery": "npm run verify:recovery --workspace=backend",
    "verify:phase8": "npm run verify:phase8 --workspace=backend",
    "verify:user-journey": "npm run verify:user-journey --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
